# Copy to .env and fill in real values. Loaded at build time via
# `flutter run --dart-define-from-file=.env`. .env is gitignored; this file is
# the committed template. Extra keys here are harmless — the app only reads the
# ones below.

# Supabase project URL (Dashboard → Project Settings → API → Project URL).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key — the modern client-side key (sb_publishable_…) that
# replaces the legacy `anon` JWT. Dashboard → Project Settings → API keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional, unused at this stage.
GEMINI_API_KEY=
